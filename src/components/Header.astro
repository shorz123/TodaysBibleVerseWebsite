---
import '@fontsource-variable/montserrat/wght.css';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<nav class="navbar" aria-label="Primary navigation">
		<a class="header-logo" href="/" aria-label="Today’s Bible Verse home">
			<img src="/images/logo.png" alt="" width="1672" height="941" />
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="primary-links"
			aria-label="Open navigation menu"
			data-menu-toggle
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<div class="nav-links" id="primary-links" data-nav-links data-open="false">
			<a href="/#phone-app">Mobile App</a>
			<a href="/privacy/" aria-current={currentPath.startsWith('/privacy') ? 'page' : undefined}>
				Privacy Policy
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		width: 100%;
		background: var(--color-background);
	}

	.navbar {
		width: min(100% - (var(--page-padding) * 2), var(--page-width));
		min-height: 4.5rem;
		margin: 20px auto;
		display: grid;
		grid-template-columns: repeat(3, max-content);
		align-items: center;
		justify-content: flex-start;
		gap: clamp(2.5rem, 7vw, 7rem);
	}

	.header-logo {
		flex: 0 0 auto;
		display: block;
	}

	.header-logo img {
		display: block;
		width: 8rem;
		height: auto;
	}

	.menu-toggle {
		display: none;
	}

	.nav-links {
		display: contents;
	}

	.nav-links a {
		color: #b8b8b8;
		font-family: 'Montserrat Variable', Arial, sans-serif;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 150ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible,
	.nav-links a[aria-current='page'] {
		color: #ffffff;
	}

	.nav-links a:focus-visible,
	.header-logo:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 0.3rem;
	}

	@media (max-width: 48rem) {
		.navbar {
			display: grid;
			grid-template-columns: 1fr auto;
			justify-content: stretch;
			gap: 0;
		}

		.header-logo {
			grid-column: 1;
			justify-self: start;
			margin-left: 1rem;
		}

		.header-logo img {
			width: 8rem;
		}

		.menu-toggle {
			grid-column: 2;
			justify-self: end;
			width: 2.75rem;
			height: 2.75rem;
			padding: 0.65rem;
			border: 0;
			background: transparent;
			color: #ffffff;
			cursor: pointer;
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.3rem;
		}

		.menu-toggle span {
			display: block;
			width: 100%;
			height: 2px;
			background: currentColor;
		}

		.menu-toggle:focus-visible {
			outline: 2px solid #ffffff;
			outline-offset: 0.2rem;
		}

		.nav-links {
			grid-column: 1 / -1;
			width: 100%;
			padding: 1rem 0 0.5rem;
			display: none;
			align-items: center;
			flex-direction: column;
			justify-content: center;
			gap: 1rem;
		}

		.nav-links[data-open='true'] {
			display: flex;
		}

		.nav-links a {
			font-size: 0.75rem;
		}
	}
</style>

<script>
	const menuToggle = document.querySelector('[data-menu-toggle]');
	const navLinks = document.querySelector('[data-nav-links]');

	if (menuToggle instanceof HTMLButtonElement && navLinks instanceof HTMLElement) {
		const setMenuOpen = (isOpen: boolean) => {
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute(
				'aria-label',
				isOpen ? 'Close navigation menu' : 'Open navigation menu',
			);
			navLinks.dataset.open = String(isOpen);
		};

		menuToggle.addEventListener('click', () => {
			setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
		});

		navLinks.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});
	}
</script>
