---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Today’s Bible Verse | Daily Scripture App"
	description="Today’s Bible Verse is a daily Scripture app featuring 366 carefully selected Bible verses to encourage and strengthen your Christian faith."
	canonical="https://todaysbibleverse.org/"
>
	<section class="mobile-app" id="phone-app" aria-label="Today’s Bible Verse mobile app">
		<div class="mobile-app-layout">
			<img
				class="phone-preview"
				src="/images/todaysbibleverseavailable.png"
				alt="Today’s Bible Verse app displayed on a smartphone"
				width="1024"
				height="1536"
				loading="lazy"
				decoding="async"
			/>
			<div class="mobile-app-copy">
				<img
					class="message-logo"
					src="/images/logo.png"
					alt="Today’s Bible Verse"
					width="1672"
					height="941"
					loading="lazy"
					decoding="async"
				/>
				<div class="message-divider" aria-hidden="true"></div>
				<p>
					Today’s Bible Verse features daily Bible verses centered on the core truths of the Christian faith. Our hope is that these carefully selected Scriptures will encourage you, strengthen your faith, and help you spend time in God’s Word—one verse at a time.
				</p>

				<p class="signature">Sincerely,<br />The App Team</p>
				<div class="message-divider signature-divider" aria-hidden="true"></div>
			</div>
		</div>

		<div class="store-availability" aria-label="App store availability">
			<div class="store-badges">
				<div class="store-item app-store-item">
					<span class="store-status">Available Now</span>
					<div class="badge-frame">
						<a
							href="https://apps.apple.com/us/app/todays-bible-verse/id6806392025"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Download Today’s Bible Verse on the App Store"
						>
							<img
								src="/store-badges/download-on-the-app-store.svg"
								alt="Download on the App Store"
								width="135"
								height="40"
								loading="lazy"
								decoding="async"
							/>
						</a>
					</div>
				</div>

				<div class="store-item google-play-item">
					<span class="store-status">Coming Soon</span>
					<div class="badge-frame">
						<img
							src="/store-badges/get-it-on-google-play.png"
							alt="Today’s Bible Verse is coming soon to Google Play"
							width="646"
							height="250"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.mobile-app {
		padding: 4rem 1rem 4rem;
		font-family: Georgia, 'Times New Roman', serif;
	}

	.mobile-app-layout {
		display: grid;
		grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 6rem);
		max-width: 76rem;
		margin: 0 auto;
	}

	.phone-preview {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
	}

	.mobile-app-copy {
		transform: translateY(-4.5rem);
		font-family: 'Montserrat Variable', Arial, sans-serif;
		text-align: left;
	}

	.message-logo {
		display: block;
		width: min(100%, 20rem);
		height: auto;
		margin: 0 auto 3rem;
	}

	.message-divider {
		display: none;
	}

	.mobile-app-copy p {
		margin: 0 0 1.25rem;
		line-height: 1.6;
	}

	.mobile-app-copy a {
		color: #ffffff;
		overflow-wrap: anywhere;
		text-underline-offset: 0.2em;
	}

	.mobile-app-copy .signature {
		margin-bottom: 0;
	}

	.store-availability {
		margin-top: clamp(4rem, 8vw, 7rem);
		font-family: 'Montserrat Variable', Arial, sans-serif;
		text-align: center;
	}

	.store-badges {
		display: flex;
		width: 100%;
		max-width: 23.75rem;
		margin: 0 auto;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: 1.5rem;
	}

	.store-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		min-width: 0;
	}

	.store-status {
		display: block;
		margin-bottom: 0.6rem;
		color: #b8b8b8;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1rem;
	}

	.badge-frame {
		display: flex;
		width: 100%;
		height: 4.75rem;
		align-items: center;
		justify-content: center;
	}

	.badge-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.app-store-item {
		flex: 0 1 10.5rem;
	}

	.app-store-item a {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
	}

	.app-store-item a:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 0.4rem;
	}

	.google-play-item {
		flex: 0 1 11.75rem;
	}

	@media (max-width: 60rem) {
		.mobile-app-layout {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.phone-preview {
			width: min(100%, 34rem);
			margin: 0 auto;
			justify-self: center;
		}

		.mobile-app-copy {
			max-width: 36rem;
			margin: 0 auto;
			transform: none;
			text-align: center;
		}

		.message-logo {
			margin-bottom: 2rem;
		}

		.message-divider {
			display: block;
			width: min(70%, 18rem);
			margin: 0 auto 2.5rem;
			border-top: 1px solid #6f6f6f;
		}

		.signature-divider {
			margin: 2.5rem auto 0;
		}

		.store-badges {
			flex-wrap: nowrap;
			gap: 0.75rem;
		}

	}
</style>
