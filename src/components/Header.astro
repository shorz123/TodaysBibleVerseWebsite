---
import '@fontsource-variable/montserrat/wght.css';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<nav class="navbar" aria-label="Primary navigation">
		<a class="logo-link" href="/" aria-label="Today's Bible Verse home">
			<img src="/images/logo.png" alt="Today's Bible Verse" />
		</a>

		<div class="nav-links">
			<a href="/#verse-of-the-day" aria-current={currentPath === '/' ? 'page' : undefined}>
				Today's Verse
			</a>
			<a href="/#phone-app">Mobile App</a>
			<a href="/#about-contact">About / Contact</a>
			<a href="/privacy/" aria-current={currentPath === '/privacy/' ? 'page' : undefined}>
				Privacy Policy
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		width: 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		background: #0b0b0b;
	}

	.navbar {
		width: min(100% - (var(--page-padding) * 2), var(--page-width));
		min-height: 4.5rem;
		margin-inline: auto;
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
	}

	.logo-link {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo-link img {
		display: block;
		width: 8rem;
		height: auto;
	}

	.nav-links {
		min-width: 0;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(1rem, 2.5vw, 2.5rem);
	}

	.nav-links a {
		color: #b8b8b8;
		font-family: 'Montserrat Variable', Arial, sans-serif;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 150ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible,
	.nav-links a[aria-current='page'] {
		color: #ffffff;
	}

	.nav-links a:focus-visible,
	.logo-link:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 0.3rem;
	}

	@media (max-width: 48rem) {
		.navbar {
			align-items: center;
			flex-direction: column;
			gap: 0.75rem;
			padding-block: 0.75rem;
		}

		.logo-link img {
			width: 7rem;
		}

		.nav-links {
			width: 100%;
			padding-bottom: 0.4rem;
			overflow-x: auto;
			justify-content: flex-start;
			scrollbar-width: thin;
		}
	}
</style>
